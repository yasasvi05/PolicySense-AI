# Copy to .env and edit. NEVER commit .env.
# --- Database ---
# Quick start (no install needed):
DATABASE_URL=postgresql+psycopg2://postgres:1234@localhost:5432/policysense
# PostgreSQL (recommended for the real project):
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/policysense

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI / RAG (server-side only, never put these in the frontend) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=./chroma_store
SEED_DEMO_DATA=true
